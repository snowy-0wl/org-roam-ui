;;; org-roam-ui-tests.el --- Org-roam UI regression checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'org-roam-ui)
(defvar org-ref-cite-re)

(ert-deftest org-roam-ui-citekey-without-org-ref-is-optional ()
  (let (org-ref-cite-re)
    (makunbound 'org-ref-cite-re)
    (should-not (org-roam-ui--citekey-to-ref "cite:example"))))

(ert-deftest org-roam-ui-reference-retitling-reads-node-properties ()
  (let ((org-ref-cite-re "cite:")
        (org-roam-ui-retitle-ref-nodes t))
    (cl-letf (((symbol-function 'org-roam-ui--citekey-to-ref) (lambda (_) "example"))
              ((symbol-function 'org-roam-ui--find-ref-title) (lambda (_) "Reference title")))
      (let* ((node '("id" "note.org" "Old title" 0 1 nil (("ROAM_REFS" . "cite:example")) nil))
             (result (org-roam-ui--retitle-node node)))
        (should (equal (nth 2 result) "Reference title"))
        (should (equal (nth 2 node) "Old title"))))))

(ert-deftest org-roam-ui-open-selects-the-configured-websocket-port ()
  (let ((org-roam-ui-mode t)
        (org-roam-ui-port 36901)
        (org-roam-ui-ws-port 36903)
        opened)
    (let ((org-roam-ui-browser-function (lambda (url) (setq opened url))))
      (org-roam-ui-open)
      (should (equal opened "http://localhost:36901?wsPort=36903")))))

(ert-deftest org-roam-ui-failed-websocket-start-does-not-leave-a-running-mode ()
  (let ((org-roam-ui-mode nil)
        (org-roam-ui-ws-server nil)
        (org-roam-ui-open-on-start nil)
        (httpd-port httpd-port)
        (httpd-root httpd-root)
        http-running)
    (cl-letf (((symbol-function 'httpd-start) (lambda () (setq http-running t)))
              ((symbol-function 'httpd-stop) (lambda () (setq http-running nil)))
              ((symbol-function 'websocket-server)
               (lambda (&rest _) (error "Address already in use"))))
      (should-error (org-roam-ui-mode 1))
      (should-not org-roam-ui-mode)
      (should-not http-running))))

(ert-deftest org-roam-ui-can-retry-after-a-real-websocket-port-conflict ()
  (let* ((occupied (make-network-process :name "orui-test-port" :server t :host 'local :service t))
         (org-roam-ui-ws-port (process-contact occupied :service))
         (org-roam-ui-mode nil)
         (org-roam-ui-ws-server nil)
         (org-roam-ui-ws-socket nil)
         (org-roam-ui-open-on-start nil)
         (httpd-port httpd-port)
         (httpd-root httpd-root)
         http-running)
    (unwind-protect
        (cl-letf (((symbol-function 'httpd-start) (lambda () (setq http-running t)))
                  ((symbol-function 'httpd-stop) (lambda () (setq http-running nil))))
          (should-error (org-roam-ui-mode 1))
          (should-not org-roam-ui-ws-server)
          (should-not http-running)
          (delete-process occupied)
          (org-roam-ui-mode 1)
          (should (process-live-p org-roam-ui-ws-server))
          (let ((server org-roam-ui-ws-server))
            (org-roam-ui-mode 1)
            (should (eq server org-roam-ui-ws-server)))
          (org-roam-ui-mode -1)
          (should-not org-roam-ui-ws-server))
      (when (process-live-p occupied) (delete-process occupied))
      (when (and org-roam-ui-ws-server (process-live-p org-roam-ui-ws-server))
        (websocket-server-close org-roam-ui-ws-server)))))

(ert-deftest org-roam-ui-theme-can-use-default-face-without-hl-line ()
  (should (assq 'bg (org-roam-ui-get-theme))))

(ert-deftest org-roam-ui-http-responses-do-not-reuse-an-inflight-response-buffer ()
  (let ((org-roam-ui-mode t)
        (httpd-root org-roam-ui-app-build-dir)
        result)
    (httpd--ensure-buffer
      (insert "first response")
      (setq httpd--header-sent t)
      (org-roam-ui--isolate-http-request
       (lambda ()
         (httpd--ensure-buffer
           (insert "second response")
           (setq result (list (buffer-string) httpd--header-sent)))))
      (should (equal (buffer-string) "first response")))
    (should (equal result '("second response" nil)))))

(ert-deftest org-roam-ui-accepts-only-the-local-ui-origin ()
  (let ((org-roam-ui-port 36901))
    (dolist (origin '("http://localhost:36901" "http://127.0.0.1:36901" "http://[::1]:36901"))
      (should (org-roam-ui--trusted-origin-p (websocket-inner-create :url "ws://localhost" :conn nil :origin origin))))
    (dolist (origin '(nil "null" "https://evil.example" "http://localhost:36902"
                      "http://localhost.evil.example:36901"))
      (should-not (org-roam-ui--trusted-origin-p (websocket-inner-create :url "ws://localhost" :conn nil :origin origin))))))

(ert-deftest org-roam-ui-untrusted-client-cannot-read-or-send-messages ()
  (let ((ws (websocket-inner-create :url "ws://localhost" :conn nil :origin "https://evil.example"))
        (org-roam-ui-ws-socket 'existing)
        closed)
    (cl-letf (((symbol-function 'websocket-close) (lambda (_) (setq closed t)))
              ((symbol-function 'org-roam-ui--send-variables) (lambda (&rest _) (error "disclosed"))))
      (org-roam-ui--ws-on-open ws)
      (should closed)
      (should (eq org-roam-ui-ws-socket 'existing))
      (setq closed nil)
      (should-error (org-roam-ui--ws-on-message ws nil))
      (should closed))))

(ert-deftest org-roam-ui-delete-resolves-id-and-rejects-headings ()
  (let ((file (make-temp-file "orui-node-"))
        (other (make-temp-file "orui-other-")))
    (unwind-protect
        (let ((node (org-roam-node-create :id "id" :level 0 :file file)))
          (cl-letf (((symbol-function 'org-roam-node-from-id)
                     (lambda (id) (and (equal id "id") node)))
                    ((symbol-function 'org-roam-db-sync) #'ignore)
                    ((symbol-function 'org-roam-ui--send-graphdata) #'ignore))
            (should-error (org-roam-ui--on-msg-delete-node '((id . "missing"))))
            (setf (org-roam-node-level node) 1)
            (should-error (org-roam-ui--on-msg-delete-node '((id . "id"))))
            (should (file-exists-p file))
            (setf (org-roam-node-level node) 0)
            (org-roam-ui--on-msg-delete-node `((id . "id") (file . ,other)))
            (should-not (file-exists-p file))
            (should (file-exists-p other))))
      (when (file-exists-p file) (delete-file file))
      (when (file-exists-p other) (delete-file other)))))

(ert-deftest org-roam-ui-delete-preserves-unsaved-buffer ()
  (let* ((file (make-temp-file "orui-unsaved-"))
         (buffer (find-file-noselect file))
         (node (org-roam-node-create :id "id" :level 0 :file file)))
    (unwind-protect
        (cl-letf (((symbol-function 'org-roam-node-from-id) (lambda (_) node)))
          (with-current-buffer buffer (insert "unsaved"))
          (should-error (org-roam-ui--on-msg-delete-node '((id . "id"))))
          (should (file-exists-p file)))
      (with-current-buffer buffer (set-buffer-modified-p nil))
      (kill-buffer buffer)
      (delete-file file))))

(ert-deftest org-roam-ui-rejected-client-close-preserves-current-session ()
  (let ((org-roam-ui-ws-socket 'active)
        (after-save-hook '(org-roam-ui--on-save))
        stopped)
    (cl-letf (((symbol-function 'org-roam-ui-settings-disconnect) #'ignore)
              ((symbol-function 'org-roam-ui-follow-mode) (lambda (&rest _) (setq stopped t))))
      (org-roam-ui--ws-on-close 'rejected)
      (should (eq org-roam-ui-ws-socket 'active))
      (should (memq #'org-roam-ui--on-save after-save-hook))
      (should-not stopped))))
